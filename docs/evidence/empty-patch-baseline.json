            "output": "import unittest\n\nfrom normalizer import normalize_tags\n\n\nclass NormalizerTests(unittest.TestCase):\n    def test_lowercase_and_sort(self):\n        self.assertEqual(normalize_tags([\"Zebra\", \"apple\"]), [\"apple\", \"zebra\"])\n"
